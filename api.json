                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set('jwt_token', jsonData.token);",
                  "    }",
                  "    if (jsonData.user && jsonData.user.user_id) {",
                  "        pm.environment.set('user_id', jsonData.user.user_id);",
